{
  "name": "pair-p2p",
  "version": "1.1.65",
  "description": "Private small-group peer-to-peer communication",
  "main": "main.js",
  "author": {
    "name": "Knot",
    "email": "pair@example.com"
  },
  "homepage": "https://github.com/Mund0o/knot",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "signal": "node server.js",
    "worker:dev": "wrangler dev",
    "worker:check": "wrangler deploy --dry-run",
    "test:ui": "electron tests/ui-navigation-smoke.js",
    "test:screen:h264": "electron tests/screen-quality-smoke.js --codec=H264",
    "test:screen:av1": "electron tests/screen-quality-smoke.js --codec=AV1",
    "test:screen:native": "electron tests/native-presentation-cadence.js && node tests/native-screen-live.js && electron tests/native-screen-transport.js",
    "test:screen:full": "electron tests/full-app-screen-endurance.js",
    "test:screen": "node tests/run-screen-suite.js",
    "test:windows-audio": "node tests/windows-audio-addon-guard.js && electron tests/windows-audio-renderer-smoke.js",
    "test:gpu": "node tests/linux-gpu-selection.js && node tests/gpu-acceleration-policy.js && node tests/native-screen-service.js && electron tests/linux-gpu-runtime.js",
    "test": "npm run test:windows-audio && npm run test:gpu && npm run test:ui && npm run test:screen",
    "deploy": "wrangler deploy",
    "dist": "electron-builder --linux tar.gz AppImage",
    "dist:win": "npm run verify:addon && electron-builder --win nsis",
    "dist:all": "npm run verify:addon && electron-builder --win nsis --linux tar.gz AppImage",
    "rebuild:addon": "node rebuild-addon.js",
    "verify:addon": "node scripts/windows-audio-addon-guard.js",
    "publish": "node publish-update.js"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "node-gyp": "12.4.0",
    "wrangler": "^4.120.0"
  },
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "ws": "^8.18.3"
  },
  "build": {
    "asar": true,
    "beforePack": "scripts/before-pack.js",
    "appId": "com.pair.p2p",
    "productName": "Knot",
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "main.js",
      "linux-gpu.js",
      "gpu-acceleration.js",
      "native-video.js",
      "native-screen.js",
      "preload.js",
      "screen-audio-worklet.js",
      "scripts/before-pack.js",
      "scripts/windows-audio-addon-guard.js",
      "updater.js",
      "linux-launcher.js",
      "server.js",
      "build/**/*"
    ],
    "linux": {
      "target": [
        "tar.gz",
        "AppImage"
      ],
      "category": "Utility",
      "icon": "icon.png",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Knot Setup ${version}.${ext}",
      "icon": "icon.ico",
      "extraResources": [
        {
          "from": "addon/build/Release/pair-capture.node",
          "to": "app.asar.unpacked/addon/build/Release/pair-capture.node"
        },
        {
          "from": "addon/build/Release/pair-capture.manifest.json",
          "to": "app.asar.unpacked/addon/build/Release/pair-capture.manifest.json"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": "true"
    }
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "workerd@1.20260801.1": true
  },
  "desktopName": "com.pair.p2p"
}
