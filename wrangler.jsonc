{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pair",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-08",
  // The checked-in Free-plan deployment is control-plane only. Managed SFU
  // media and object-relay storage remain explicit, locally configurable
  // adapters and are never enabled by a normal `wrangler deploy`.
  "vars": {
    "GROUP_CALL_SFU_ENABLED": "false",
    "ENCRYPTED_FILE_RELAY_ENABLED": "false"
  },
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PAIR_ROOMS",
        "class_name": "PairRoom"
      },
      {
        "name": "PAIR_DIRECTORY",
        "class_name": "PairDirectory"
      },
      {
        "name": "PAIR_DIRECTORY_V2",
        "class_name": "PairDirectoryShardV2"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PairRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PairDirectory"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["PairDirectoryShardV2"]
    }
  ]
}
