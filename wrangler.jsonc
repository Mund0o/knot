{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pair",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-08",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PAIR_ROOMS",
        "class_name": "PairRoom"
      },
      {
        "name": "PAIR_DIRECTORY",
        "class_name": "PairDirectory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PairRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PairDirectory"]
    }
  ]
}
